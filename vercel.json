{
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "site",
  "cleanUrls": true,
  "headers": [
    { "source": "/(.*)", "headers": [ { "key": "X-Robots-Tag", "value": "noindex, nofollow" } ] },
    { "source": "/data/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=3600" } ] }
  ]
}
